   RowBox[{"{", 
    RowBox[{"X", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Black", ",", "Red"}], "}"}]}], ",", 
