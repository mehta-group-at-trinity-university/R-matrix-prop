Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<X*tan(delta_MS) = \>\"", ",", " ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"X", "*", 
      RowBox[{"tanMS", "[", "X", "]"}]}], "]"}]}], "]"}], ";"}]], "Input",
