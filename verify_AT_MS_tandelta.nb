Cell["\<\
These two are still not equal to each other directly -- but check the \
PRODUCT, matching the tan(delta_MS)=-1/tan(delta_AT) convention relation \
established earlier this session (from comparing the two papers' respective \
asymptotic S-matrix definitions):\
\>", "Text",ExpressionUUID->"1b17f61d-74dd-45af-8507-2ab7f4d19ba5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"product", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"tanATinX", "*", 
     RowBox[{"tanMS", "[", "X", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"744f06a9-2511-45d8-9a16-6085f57c8ade"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<tan(delta_AT)*tan(delta_MS) = \>\"", ",", " ", "product", ",",
     " ", "\"\<  (should be -1)\>\""}], "]"}], ";"}]], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"d6239d3d-0c94-45bb-9339-22bc8151ea01"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"tan(delta_AT)*tan(delta_MS) = \"\>", "\[InvisibleSpace]", 
   RowBox[{"-", "1"}], "\[InvisibleSpace]", "\<\"  (should be -1)\"\>"}],
  SequenceForm["tan(delta_AT)*tan(delta_MS) = ", -1, "  (should be -1)"],
  Editable->False]], "Print",
 CellChangeTimes->{3.9938449691948023`*^9},
 CellLabel->
  "During evaluation of \
In[58]:=",ExpressionUUID->"a1d66c87-8575-4dec-bf30-fe11d364e843"]
}, Open  ]],

Cell["\<\
Confirmed exactly (symbolically, for all X): tan(delta_AT)*tan(delta_MS) = \
-1. Amaya-Tapia's Eq. 61 and Mehta-Shepard's Eq. 10/12 ARE consistent, once \
(a) aAT is correctly identified as 1/a2std rather than a2std itself, and (b) \
the two papers' independently-known reciprocal phase-shift convention is \
accounted for.\
\>", "Text",ExpressionUUID->"1af65bbd-b469-4ad5-af75-50b67764f1d8"],

